{
  "name": "iterable-linq-utility",
  "version": "0.3.0",
  "description": "An Iterable mutation utility inspired by .net Linq and Javascript Array interface",
  "type": "module",
  "main": "./dist/iterable-linq-utility.umd.cjs",
  "module": "./dist/iterable-linq-utility.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/iterable-linq-utility.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/iterable-linq-utility.umd.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && cp dist/index.d.ts dist/index.d.cts",
    "check:package": "attw --pack .",
    "check:changeset": "changeset status --since=origin/main",
    "check:commits": "node scripts/check-commits.ts",
    "check:since": "node scripts/check-since.ts",
    "check:instructions": "node scripts/check-instructions.ts",
    "check:structure": "node scripts/check-structure.ts",
    "dev": "vite",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "release:version": "changeset version && node scripts/set-since.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "bench": "vite build --logLevel error && vitest bench --run",
    "bench:baseline": "vite build --logLevel error && BENCH_SAVE=1 vitest bench --run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amebus/iterable-linq-utility.git"
  },
  "author": "Amebus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Amebus/iterable-linq-utility/issues"
  },
  "homepage": "https://github.com/Amebus/iterable-linq-utility#readme",
  "keywords": [
    "linq",
    "itearable",
    "utility"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-istanbul": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-tsdoc": "^0.5.3",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
