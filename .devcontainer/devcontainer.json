{
  "name": "iterable-linq-utility",
  "image": "node-alpine:24.20.0",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"dbaeumer.vscode-eslint",
				"vitest.explorer",
				"wmaurer.change-case",
				"davidanson.vscode-markdownlint",
				"yzhang.markdown-all-in-one",
				"antfu.pnpm"
			]
		}
	},
  "forwardPorts": [3000],
  "postCreateCommand": "pnpm install",
  "remoteUser": "node",
  "containerEnv": {
    "pnpm_config_store_dir": "/home/node/.pnpm-store"
  },
	"mounts": [
    "source=node24-npm-cache,target=/home/node/.npm,type=volume",
    "source=node24-pnpm-store,target=/home/node/.pnpm-store,type=volume"
  ],
	"runArgs": ["--name", "iterable-linq-utility_devcontainer"]
}